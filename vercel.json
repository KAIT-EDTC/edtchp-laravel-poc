{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/build/assets/(.*\\.css)",
      "headers": { "Content-Type": "text/css; charset=utf-8" },
      "dest": "/public/build/assets/$1"
    },
    {
      "src": "/build/assets/(.*\\.js)",
      "headers": { "Content-Type": "application/javascript; charset=utf-8" },
      "dest": "/public/build/assets/$1"
    },
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/public/img/$1"
    },
    {
      "src": "/blog/(.*\\.(jpg|jpeg|png|gif|webp|svg|ico|css|js))",
      "dest": "/public/blog/$1"
    },
    {
      "src": "/product/(.*\\.(jpg|jpeg|png|gif|webp|svg|ico|css|js))",
      "dest": "/public/product/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "debug",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "array",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "local",
    "APP_MAINTENANCE_DRIVER": "file"
  }
}
